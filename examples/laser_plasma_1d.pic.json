{
  "version": 1,
  "name": "Laser - plasma slab interaction (1D)",
  "description": "800 nm laser pulse (a0 = 0.05) incident on a plasma slab. With nfrac > 1 (overdense) the pulse is reflected; with nfrac < 1 it propagates with v_g = c sqrt(1 - n/n_c).",
  "parameters": {
    "lam": "0.8e-6",
    "w": "2*pi*c/lam",
    "nc": "eps0*me*w**2/e**2",
    "nfrac": "2.0",
    "Lx": "60*lam"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "absorbing",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 40
    },
    "z_max": {
      "name": "",
      "field": "absorbing",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 40
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electromagnetic",
    "t_end": "300e-15",
    "dt": "auto",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "Lx",
    "nz": "2400",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_laser_plasma_1d",
    "history_every": "2",
    "field_every": "500",
    "particle_every": "2000",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [],
  "species": [
    {
      "name": "electrons",
      "preset": "electron"
    },
    {
      "name": "ions",
      "preset": "proton"
    }
  ],
  "loaders": [
    {
      "name": "slab",
      "species": "electrons",
      "z0": "30*lam",
      "z1": "50*lam",
      "y0": "0",
      "y1": "1",
      "density": "nfrac*nc",
      "ppc": "50",
      "temperature": "10"
    },
    {
      "name": "slab ions",
      "species": "ions",
      "z0": "30*lam",
      "z1": "50*lam",
      "y0": "0",
      "y1": "1",
      "density": "nfrac*nc",
      "ppc": "50",
      "temperature": "0"
    }
  ],
  "emitters": [],
  "external_fields": [],
  "sources": [
    {
      "name": "laser",
      "type": "laser",
      "z_position": "2*lam",
      "wavelength": "lam",
      "a0": "0.05",
      "duration": "15e-15",
      "t_peak": "30e-15",
      "polarization": "x"
    }
  ],
  "probes": [
    {
      "name": "Ex_front",
      "quantity": "Ex",
      "z": "10*lam",
      "y": "0"
    }
  ],
  "line_probes": [],
  "power_lines": [
    {
      "name": "S_front",
      "orientation": "z",
      "position": "10*lam",
      "start": "0",
      "end": "1"
    }
  ]
}