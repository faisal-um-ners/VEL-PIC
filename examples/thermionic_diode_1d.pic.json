{
  "version": 1,
  "name": "Thermionic diode: SCL to temperature-limited",
  "description": "Richardson-Dushman-Schottky emission (W = 4.5 eV, 2500 K) in a 1 mm gap. Sweep V0 to see the 3/2-power (space-charge) and saturated (temperature-limited) regimes.",
  "parameters": {
    "V0": "300",
    "d": "1e-3"
  },
  "boundaries": {
    "z_min": {
      "name": "cathode",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "anode",
      "field": "conductor",
      "voltage": "V0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "5e-9",
    "dt": "auto",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "d",
    "nz": "200",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_thermionic_diode_1d",
    "history_every": "20",
    "field_every": "1000",
    "particle_every": "1000",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "V0",
    "values": "[30, 100, 300, 1000, 3000]",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [
    {
      "name": "vacuum gap",
      "shape": "rectangle",
      "material": "vacuum",
      "z0": "0",
      "z1": "d",
      "y0": "0",
      "y1": "1"
    }
  ],
  "species": [
    {
      "name": "electrons",
      "preset": "electron"
    }
  ],
  "loaders": [],
  "emitters": [
    {
      "name": "cathode",
      "species": "electrons",
      "model": "thermionic",
      "z0": "0",
      "work_function": "4.5",
      "cathode_temperature": "2500",
      "schottky": true,
      "particles_per_cell": "40"
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}