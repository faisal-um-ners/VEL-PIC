{
  "version": 1,
  "name": "Two-stream instability (1D)",
  "description": "Two counter-streaming cold electron beams on a neutralizing background; mode 1 is at the maximum growth k v0 = sqrt(3)/2 w_pb, gamma_max = w_pb/2.",
  "parameters": {
    "n0": "1e14",
    "v0": "1e6",
    "wpb": "sqrt(n0/2*e**2/(eps0*me))",
    "L": "2*pi*v0/(sqrt(3)/2*wpb)"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "periodic",
      "voltage": "0",
      "particles": "periodic",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "periodic",
      "voltage": "0",
      "particles": "periodic",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "45/wpb",
    "dt": "0.05/wpb",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "L",
    "nz": "64",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_two_stream_1d",
    "history_every": "5",
    "field_every": "100",
    "particle_every": "100",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [],
  "species": [
    {
      "name": "beam_right",
      "preset": "electron"
    },
    {
      "name": "beam_left",
      "preset": "electron"
    }
  ],
  "loaders": [
    {
      "name": "right",
      "species": "beam_right",
      "drift": [
        "v0",
        "0",
        "0"
      ],
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "n0/2",
      "ppc": "400",
      "quiet_start": true,
      "perturbation": "velocity",
      "pert_amplitude": "1e-4*v0",
      "pert_mode": "1"
    },
    {
      "name": "left",
      "species": "beam_left",
      "drift": [
        "-v0",
        "0",
        "0"
      ],
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "n0/2",
      "ppc": "400",
      "quiet_start": true,
      "perturbation": "velocity",
      "pert_amplitude": "-1e-4*v0",
      "pert_mode": "1"
    }
  ],
  "emitters": [],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}