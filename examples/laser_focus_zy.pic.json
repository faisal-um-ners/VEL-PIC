    "z_max": {
      "name": "",
      "field": "absorbing",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 20
    },
    "y_min": {
      "name": "",
      "field": "absorbing",
      "voltage": "0",
      "particles": "absorb",
