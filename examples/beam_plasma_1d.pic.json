{
  "version": 1,
  "name": "Weak beam - plasma instability (1D)",
  "description": "Cold beam (alpha = n_b/n_p = 1e-3) through a cold plasma; growth rate gamma = (sqrt(3)/2^(4/3)) alpha^(1/3) w_p at k = w_p/v_b.",
  "parameters": {
    "np0": "1e14",
    "alpha": "1e-3",
    "vb": "1e7",
    "wp": "sqrt(np0*e**2/(eps0*me))",
    "L": "2*pi*vb/wp"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "periodic",
      "voltage": "0",
      "particles": "periodic",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "periodic",
      "voltage": "0",
      "particles": "periodic",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "150/wp",
    "dt": "0.05/wp",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "L",
    "nz": "64",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_beam_plasma_1d",
    "history_every": "5",
    "field_every": "200",
    "particle_every": "200",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [],
  "species": [
    {
      "name": "plasma",
      "preset": "electron"
    },
    {
      "name": "beam",
      "preset": "electron"
    }
  ],
  "loaders": [
    {
      "name": "plasma",
      "species": "plasma",
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "np0",
      "ppc": "200",
      "quiet_start": true
    },
    {
      "name": "beam",
      "species": "beam",
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "alpha*np0",
      "ppc": "200",
      "quiet_start": true,
      "drift": [
        "vb",
        "0",
        "0"
      ],
      "perturbation": "velocity",
      "pert_amplitude": "1e-5*vb",
      "pert_mode": "1"
    }
  ],
  "emitters": [],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}