{
  "version": 1,
  "name": "Pierce diode instability (1D)",
  "description": "Cold electron beam injected through a grounded gap with a neutralizing ion background (Pierce diode). For a Pierce parameter alpha = w_p L / v0 = 2.5 pi the equilibrium is unstable; the exact dispersion root is w = (1.429 + 0.589i) v0/L. Compare with benchmarks/bench_published.py (pierce).",
  "parameters": {
    "n0": "1e13",
    "v0": "1e6",
    "alpha": "2.5*pi",
    "wp": "sqrt(n0*e**2/(eps0*me))",
    "L": "alpha*v0/wp"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "12*L/v0",
    "dt": "0.25*L/200/v0",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "L",
    "nz": "200",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_pierce_diode_1d",
    "history_every": "4",
    "field_every": "400",
    "particle_every": "400",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [],
  "species": [
    {
      "name": "electrons",
      "preset": "electron"
    },
    {
      "name": "ions",
      "preset": "custom",
      "charge": "1",
      "mass": "1e6*mp"
    }
  ],
  "loaders": [
    {
      "name": "beam",
      "species": "electrons",
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "n0",
      "ppc": "64",
      "quiet_start": true,
      "drift": [
        "v0",
        "0",
        "0"
      ],
      "perturbation": "velocity",
      "pert_amplitude": "1e-3*v0",
      "pert_mode": "0.5"
    },
    {
      "name": "background",
      "species": "ions",
      "z0": "0",
      "z1": "L",
      "y0": "0",
      "y1": "1",
      "density": "n0",
      "ppc": "64",
      "quiet_start": true
    }
  ],
  "emitters": [
    {
      "name": "gun",
      "species": "electrons",
      "model": "beam",
      "z0": "0",
      "y0": "0",
      "z1": "0",
      "y1": "1",
      "normal": "+z",
      "current_density": "e*n0*v0",
      "energy": "0.5*me*v0**2/e",
      "temperature": "0",
      "particles_per_cell": "64"
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [],
  "power_lines": []
}