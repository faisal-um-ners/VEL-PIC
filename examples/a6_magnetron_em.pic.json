{
  "version": 1,
  "name": "A6 relativistic magnetron with loss port (2D EM)",
  "description": "Bekefi A6 relativistic magnetron cross-section: cathode r=1.58 cm, anode r=2.11 cm, 6 vanes to r=4.11 cm (20 deg cavities), axial B (out of plane), explosive (SCL) emission from the whole cathode surface. The outer half of cavity 1 is a lossy load (loss port) giving a defined loaded Q = Qload (250) for the cold-test pi-mode at 2.313 GHz (fill calibrated by ring-down, Model > Calibrate loss Q; re-run it after changing the geometry or Qload). Operating point of the experiment (Bekefi & Orzechowski 1976): V0 = 360 kV, B0 = 0.8 T, inside the window between the smooth-bore Hull field (0.51 T, Lovelace-Ott) and the pi-mode Buneman-Hartree field (0.82 T). The pi mode starts at ~15 ns and oscillates at ~2.16 GHz (measured ~2.3 GHz); see benchmark 21.",
  "parameters": {
    "V0": "360e3",
    "B0": "0.8",
    "rc": "1.58e-2",
    "ra": "2.11e-2",
    "rv": "4.11e-2",
    "hw": "10*pi/180",
    "Lb": "5.6e-2",
    "Qload": "250",
    "f0": "2.313e9"
  },
  "boundaries": {
    "z_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "2D-ZY",
    "solver": "electromagnetic",
    "t_end": "40e-9",
    "dt": "auto",
    "cfl": "0.9",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 1,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
