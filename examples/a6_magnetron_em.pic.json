      "material": "vacuum"
    },
    {
      "name": "cavity 4",
      "shape": "polygon",
      "points": "0.9*ra*cos(180.0*pi/180 + -1*hw),0.9*ra*sin(180.0*pi/180 + -1*hw); rv*cos(180.0*pi/180 + -1*hw),rv*sin(180.0*pi/180 + -1*hw); rv/cos(hw)*cos(180.0*pi/180),rv/cos(hw)*sin(180.0*pi/180); rv*cos(180.0*pi/180 + 1*hw),rv*sin(180.0*pi/180 + 1*hw); 0.9*ra*cos(180.0*pi/180 + 1*hw),0.9*ra*sin(180.0*pi/180 + 1*hw)",
      "material": "vacuum"
    },
    {
      "name": "cavity 5",
      "shape": "polygon",
      "points": "0.9*ra*cos(240.0*pi/180 + -1*hw),0.9*ra*sin(240.0*pi/180 + -1*hw); rv*cos(240.0*pi/180 + -1*hw),rv*sin(240.0*pi/180 + -1*hw); rv/cos(hw)*cos(240.0*pi/180),rv/cos(hw)*sin(240.0*pi/180); rv*cos(240.0*pi/180 + 1*hw),rv*sin(240.0*pi/180 + 1*hw); 0.9*ra*cos(240.0*pi/180 + 1*hw),0.9*ra*sin(240.0*pi/180 + 1*hw)",
      "material": "vacuum"
    },
    {
      "name": "cavity 6",
      "shape": "polygon",
      "points": "0.9*ra*cos(300.0*pi/180 + -1*hw),0.9*ra*sin(300.0*pi/180 + -1*hw); rv*cos(300.0*pi/180 + -1*hw),rv*sin(300.0*pi/180 + -1*hw); rv/cos(hw)*cos(300.0*pi/180),rv/cos(hw)*sin(300.0*pi/180); rv*cos(300.0*pi/180 + 1*hw),rv*sin(300.0*pi/180 + 1*hw); 0.9*ra*cos(300.0*pi/180 + 1*hw),0.9*ra*sin(300.0*pi/180 + 1*hw)",
      "material": "vacuum"
    },
    {
      "name": "loss port",
      "shape": "rectangle",
      "z0": "0.5*(ra+rv)",
      "z1": "rv+1e-3",
      "y0": "-0.5*(ra+rv)*tan(hw)",
      "y1": "0.5*(ra+rv)*tan(hw)",
      "material": "lossy",
      "loss_spec": "Q",
      "Q": "Qload",
      "frequency": "f0",
      "fill": "0.01136"
    },
    {
      "name": "cathode",
      "shape": "circle",
      "zc": "0",
      "yc": "0",
      "radius": "rc",
      "material": "conductor",
      "voltage": "-V0*min(t/2e-9,1)"
    }
  ],
  "species": [
