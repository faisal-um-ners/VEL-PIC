  "domain": {
    "z_min": "-Lb",
    "z_max": "Lb",
    "nz": "224",
    "y_min": "-Lb",
    "y_max": "Lb",
    "ny": "224"
  },
  "diagnostics": {
    "output_dir": "output_a6_magnetron_em",
    "history_every": "5",
    "field_every": "1000",
    "particle_every": "1000",
    "max_dump_particles": "50000",
    "live_every": "100"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "",
    "values": "linspace(0,1,5)",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [
    {
      "name": "anode block",
      "shape": "rectangle",
      "z0": "-2*Lb",
      "z1": "2*Lb",
      "y0": "-2*Lb",
      "y1": "2*Lb",
      "material": "conductor",
      "voltage": "0"
    },
    {
      "name": "interaction space",
      "shape": "circle",
      "zc": "0",
      "yc": "0",
      "radius": "ra",
      "material": "vacuum"
    },
    {
      "name": "cavity 1",
      "shape": "polygon",
      "points": "0.9*ra*cos(0.0*pi/180 + -1*hw),0.9*ra*sin(0.0*pi/180 + -1*hw); rv*cos(0.0*pi/180 + -1*hw),rv*sin(0.0*pi/180 + -1*hw); rv/cos(hw)*cos(0.0*pi/180),rv/cos(hw)*sin(0.0*pi/180); rv*cos(0.0*pi/180 + 1*hw),rv*sin(0.0*pi/180 + 1*hw); 0.9*ra*cos(0.0*pi/180 + 1*hw),0.9*ra*sin(0.0*pi/180 + 1*hw)",
      "material": "vacuum"
    },
    {
      "name": "cavity 2",
      "shape": "polygon",
      "points": "0.9*ra*cos(60.0*pi/180 + -1*hw),0.9*ra*sin(60.0*pi/180 + -1*hw); rv*cos(60.0*pi/180 + -1*hw),rv*sin(60.0*pi/180 + -1*hw); rv/cos(hw)*cos(60.0*pi/180),rv/cos(hw)*sin(60.0*pi/180); rv*cos(60.0*pi/180 + 1*hw),rv*sin(60.0*pi/180 + 1*hw); 0.9*ra*cos(60.0*pi/180 + 1*hw),0.9*ra*sin(60.0*pi/180 + 1*hw)",
