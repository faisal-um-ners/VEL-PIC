{
  "version": 1,
  "name": "Child-Langmuir planar diode (1D)",
  "description": "Space-charge-limited (Gauss-law) emission in a planar vacuum diode. Compare the anode current density with J_CL = 4 eps0/9 sqrt(2e/m) V^1.5/d^2.",
  "parameters": {
    "V0": "1000",
    "d": "1e-3",
    "JCL": "4*eps0/9*sqrt(2*e/me)*V0**1.5/d**2"
  },
  "boundaries": {
    "z_min": {
      "name": "cathode",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "z_max": {
      "name": "anode",
      "field": "conductor",
      "voltage": "V0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_min": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    },
    "y_max": {
      "name": "",
      "field": "conductor",
      "voltage": "0",
      "particles": "absorb",
      "absorber_cells": 16
    }
  },
  "simulation": {
    "geometry": "1D-Z",
    "solver": "electrostatic",
    "t_end": "2e-9",
    "dt": "auto",
    "cfl": "0.95",
    "n_steps": "",
    "relativistic": true,
    "particle_pusher": "boris",
    "field_gathering": "auto",
    "smoothing": 0,
    "em_conductors": "held at their potentials",
    "current_filter": 0,
    "axis_correction": true,
    "initial_field": "poisson",
    "seed": 12345,
    "max_particles": "2e7"
  },
  "domain": {
    "z_min": "0",
    "z_max": "d",
    "nz": "100",
    "y_min": "0",
    "y_max": "1e-2",
    "ny": "128"
  },
  "diagnostics": {
    "output_dir": "output_child_langmuir_1d",
    "history_every": "20",
    "field_every": "500",
    "particle_every": "500",
    "max_dump_particles": "50000",
    "live_every": "50"
  },
  "parallel": {
    "mode": "threads",
    "ranks": 4,
    "threads": 0
  },
  "sweep": {
    "enabled": false,
    "parameter": "V0",
    "values": "[250, 500, 1000, 2000]",
    "workers": 2
  },
  "mesh_refinements": [],
  "objects": [
    {
      "name": "vacuum gap",
      "shape": "rectangle",
      "material": "vacuum",
      "z0": "0",
      "z1": "d",
      "y0": "0",
      "y1": "1"
    }
  ],
  "species": [
    {
      "name": "electrons",
      "preset": "electron"
    }
  ],
  "loaders": [],
  "emitters": [
    {
      "name": "cathode",
      "species": "electrons",
      "model": "scl",
      "z0": "0",
      "particles_per_cell": "10"
    }
  ],
  "external_fields": [],
  "sources": [],
  "probes": [],
  "line_probes": [
    {
      "name": "phi",
      "quantity": "phi",
      "extremum": "min",
      "along": "z",
      "y": "0",
      "start": "0",
      "end": "d"
    }
  ],
  "power_lines": []
}